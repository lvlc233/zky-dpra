# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/paper

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_REDIS_URL=redis://127.0.0.1:6379/1

# AI Models
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Configuration
# Options: local, siliconflow, openai, ollama
EMBEDDING_TYPE=local

# Local Embedding (BGE-M3 ONNX)
# 注意: Windows路径在.env中通常可以直接写，或者用双斜杠
LOCAL_EMBEDDING_MODEL_PATH="D:\\模型\\bge-m3-onnx\\bge-m3-onnx"

# SiliconFlow Embedding (Fallback)
SILICONFLOW_API_KEY=sk-dtjmwtsffddmuznojosfzqqiidhvezgtrmowbfdrbuyfonzl
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# PDF Parser Configuration
# Options: marker (high quality, requires GPU/high RAM), pymupdf (fast, lightweight), auto
PDF_PARSER_TYPE=auto

# Other
LOG_LEVEL=INFO
